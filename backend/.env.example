# Copie para backend/.env e preencha. NUNCA versione o .env.
PORT=3333

DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=ditado
DATABASE_PASSWORD=ditado
DATABASE_NAME=ditado

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# https://console.groq.com -> API Keys
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
MAX_UPLOAD_MB=25

# Admin criado na primeira inicialização, se ainda não existir
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@ditado.dev
ADMIN_PASSWORD=
